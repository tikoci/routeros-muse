{
	"$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
	"files": {
		"ignoreUnknown": false,
		"includes": ["src/**/*.ts", "tests/**/*.ts", "tools/**/*.ts"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"complexity": {
				"useLiteralKeys": "off"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
