{
	"name": "@tikoci/routeros-muse",
	"version": "0.1.0-dev.0",
	"description": "A RouterOS network workspace plus web UI that puts an agent beside your network, built on quickchr/centrs/rosetta.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tikoci/routeros-muse.git"
	},
	"homepage": "https://github.com/tikoci/routeros-muse#readme",
	"bugs": {
		"url": "https://github.com/tikoci/routeros-muse/issues"
	},
	"type": "module",
	"bin": {
		"routeros-muse": "./src/index.ts"
	},
	"files": [
		"src",
		"templates",
		"doctor.toml",
		"README.md"
	],
	"scripts": {
		"start": "bun src/index.ts",
		"test": "bun test",
		"lint": "bun run lint:biome && bun run lint:typecheck",
		"lint:biome": "biome check .",
		"lint:typecheck": "tsc --noEmit",
		"lint:fix": "biome check --write ."
	},
	"dependencies": {
		"@tikoci/centrs": "next",
		"@tikoci/quickchr": "next",
		"@tikoci/rosetta": "next",
		"dompurify": "3.4.17",
		"marked": "18.1.3",
		"mermaid": "12.3.0",
		"routeros-skills": "github:tikoci/routeros-skills#37f271ff0195745aeac727daa74482d2c2abb75c"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@types/bun": "^1.4.4",
		"playwright": "1.65.0",
		"typescript": "^7.0.2"
	}
}
